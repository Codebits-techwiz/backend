# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3001

# Database Configuration
MONGODB_URI=mongodb://127.0.0.1:27017/campus_coin

# JWT Authentication
JWT_SECRET=super_secret_campus_coin_jwt_key_2026_techwiz
JWT_EXPIRES_IN=7d
COOKIE_EXPIRES_DAYS=7

# Email / Nodemailer Configuration (Optional for dev)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
FROM_EMAIL=noreply@campuscoin.edu

# Optional AI / Gemini API Key
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Rate Limiting (requests per 15-minute window)
API_RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10
